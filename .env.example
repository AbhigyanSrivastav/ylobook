# Reference only: the app does not automatically load .env files.
# CLI developer override; normal installed users use DEFAULT_API_URL.
YLOBOOK_API_URL=http://localhost:8000
GROQ_MODEL=qwen/qwen3.8-27b
# Prefer "ylobook config" for hidden key input. Never commit a real key.
GROQ_API_KEY=

# Backend only: set the real Neon connection URL in Render's secret environment.
# Include sslmode=require. Never put Groq keys on the backend.
DATABASE_URL=
